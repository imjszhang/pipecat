# Pipecat 中文优化配置示例
# 
# 将此文件重命名为 .env 并根据需要修改配置

# ===========================================
# 中文语音识别 (STT) 配置
# ===========================================

# 阿里云语音识别（推荐中文用户）
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
ALIBABA_CLOUD_REGION=cn-shanghai
# 可选区域: cn-beijing, cn-hangzhou, cn-shenzhen

# 腾讯云语音识别
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_REGION=ap-beijing
# 可选区域: ap-shanghai, ap-guangzhou, ap-chengdu

# 百度语音识别
BAIDU_API_KEY=your_api_key
BAIDU_SECRET_KEY=your_secret_key

# Azure 语音服务（支持中文方言）
AZURE_SPEECH_KEY=your_speech_key
AZURE_SPEECH_REGION=eastasia
# 可选区域: southeastasia, japaneast

# Google Cloud Speech（支持中文）
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Deepgram（支持中文）
DEEPGRAM_API_KEY=your_deepgram_api_key

# ===========================================
# 中文大语言模型 (LLM) 配置
# ===========================================

# 通义千问（阿里云）- 推荐
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_MODEL=qwen2.5-72b-instruct
# 可选模型: qwen-max, qwen-plus, qwen-turbo

# 文心一言（百度）
BAIDU_QIANFAN_ACCESS_KEY=your_access_key
BAIDU_QIANFAN_SECRET_KEY=your_secret_key
ERNIE_MODEL=ernie-4.0-8k
# 可选模型: ernie-3.5-8k, ernie-lite-8k

# 智谱 AI GLM
ZHIPUAI_API_KEY=your_zhipuai_api_key
GLM_MODEL=glm-4-plus
# 可选模型: glm-4, glm-4-air, glm-4-flash

# 月之暗面 Kimi
MOONSHOT_API_KEY=your_moonshot_api_key
KIMI_MODEL=moonshot-v1-32k
# 可选模型: moonshot-v1-8k, moonshot-v1-128k

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
# 可选模型: deepseek-coder

# 零一万物 Yi
YI_API_KEY=your_yi_api_key
YI_MODEL=yi-large
# 可选模型: yi-medium, yi-vision

# 字节跳动豆包
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_MODEL=doubao-pro-32k

# Minimax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_group_id
MINIMAX_MODEL=abab6.5s-chat

# ===========================================
# 中文语音合成 (TTS) 配置
# ===========================================

# 阿里云语音合成（推荐）
ALIBABA_TTS_ACCESS_KEY_ID=your_access_key_id
ALIBABA_TTS_ACCESS_KEY_SECRET=your_access_key_secret
ALIBABA_TTS_REGION=cn-shanghai
ALIBABA_TTS_VOICE=xiaoyun
# 可选声音: xiaogang(男声), ruoxi(温柔女声), siqi(活泼女声)

# 腾讯云语音合成
TENCENT_TTS_SECRET_ID=your_secret_id
TENCENT_TTS_SECRET_KEY=your_secret_key
TENCENT_TTS_REGION=ap-beijing
TENCENT_TTS_VOICE_TYPE=101001
# 可选声音: 101002(中文男声), 101003(中文男声2)

# 百度语音合成
BAIDU_TTS_API_KEY=your_api_key
BAIDU_TTS_SECRET_KEY=your_secret_key
BAIDU_TTS_VOICE=5118
# 可选声音: 5003(情感女声), 5118(温柔女声), 106(标准男声)

# Azure 语音合成（多音色支持）
AZURE_TTS_KEY=your_tts_key
AZURE_TTS_REGION=eastasia
AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# 可选声音:
# zh-CN-YunxiNeural (男声)
# zh-CN-YunyangNeural (男声新闻播报)
# zh-CN-XiaochenNeural (女声客服)
# zh-CN-XiaohanNeural (女声温柔)
# zh-CN-XiaomengNeural (女声甜美)
# zh-CN-XiaomoNeural (女声成熟)
# zh-CN-XiaoxuanNeural (女声活泼)
# zh-CN-XiaoruiNeural (女声温暖)
# zh-CN-XiaoshuangNeural (女声童声)
# zh-CN-XiaoyiNeural (女声温柔)
# zh-CN-XiaozhenNeural (女声温柔)
# zh-CN-YunfengNeural (男声成熟)
# zh-CN-YunhaoNeural (男声广告)
# zh-CN-YunjianNeural (男声体育解说)
# zh-CN-YunxiaNeural (男声激昂)
# zh-CN-YunyeNeural (男声成熟)
# zh-CN-YunzeNeural (男声老年)

# Google Cloud TTS
GOOGLE_TTS_PROJECT_ID=your_project_id
GOOGLE_TTS_CREDENTIALS=path/to/service-account.json
GOOGLE_TTS_VOICE=cmn-CN-Wavenet-A
# 可选声音: cmn-CN-Wavenet-B, cmn-CN-Wavenet-C, cmn-CN-Wavenet-D

# ===========================================
# 本地化 TTS 配置
# ===========================================

# Kokoro TTS 中文版本
KOKORO_TTS_BASE_URL=http://localhost:8000
KOKORO_TTS_MODEL_PATH=./models/kokoro-zh
KOKORO_TTS_VOICE=zh-CN-female
KOKORO_TTS_SPEED=1.0
KOKORO_TTS_PITCH=0.0

# XTTS 中文配置
XTTS_MODEL_PATH=./models/xtts-zh
XTTS_CONFIG_PATH=./models/xtts-zh/config.json
XTTS_SPEAKER_WAV=./voices/chinese_speaker.wav
XTTS_TEMPERATURE=0.7
XTTS_LENGTH_PENALTY=1.0
XTTS_REPETITION_PENALTY=5.0

# Piper TTS 中文模型
PIPER_MODEL_PATH=./models/zh_CN-huayan-medium.onnx
PIPER_CONFIG_PATH=./models/zh_CN-huayan-medium.onnx.json

# ===========================================
# 语言和地区设置
# ===========================================

# 默认语言
DEFAULT_LANGUAGE=zh-CN

# 支持的方言和语言变体
SUPPORTED_LANGUAGES=zh-CN,zh-TW,zh-HK,yue-CN,wuu-CN
# zh-CN: 简体中文（普通话）
# zh-TW: 繁体中文（台湾）
# zh-HK: 繁体中文（香港）
# yue-CN: 粤语
# wuu-CN: 吴语（上海话）

# 时区设置
TIMEZONE=Asia/Shanghai

# 字符编码
CHARSET=UTF-8

# ===========================================
# 音频配置
# ===========================================

# 音频采样率
AUDIO_SAMPLE_RATE=16000
# 可选: 8000, 16000, 24000, 48000

# 音频通道数
AUDIO_CHANNELS=1

# 音频格式
AUDIO_FORMAT=wav
# 可选: wav, mp3, flac

# 音频缓冲区大小
AUDIO_BUFFER_SIZE=4096

# ===========================================
# 语音活动检测 (VAD) 配置
# ===========================================

# VAD 类型
VAD_TYPE=silero
# 可选: silero, webrtc, azure

# VAD 置信度阈值
VAD_CONFIDENCE=0.7

# 语音开始检测时间 (秒)
VAD_START_SECS=0.2

# 语音结束检测时间 (秒)
VAD_STOP_SECS=2.0

# 最小音量阈值
VAD_MIN_VOLUME=0.6

# ===========================================
# 对话配置
# ===========================================

# 系统提示词
SYSTEM_PROMPT=你是一个友好、专业的中文AI助手。请用自然、简洁的语言回答用户问题，避免使用特殊符号和格式化文本。

# 最大对话轮数
MAX_CONVERSATION_TURNS=50

# 对话超时时间 (秒)
CONVERSATION_TIMEOUT=300

# 响应最大长度 (tokens)
MAX_RESPONSE_TOKENS=200

# 温度参数 (0.0-2.0)
LLM_TEMPERATURE=0.7

# Top-p 参数 (0.0-1.0)
LLM_TOP_P=0.9

# ===========================================
# 性能优化配置
# ===========================================

# 启用模型量化
ENABLE_QUANTIZATION=true

# 批处理大小
BATCH_SIZE=1

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=10

# 缓存配置
ENABLE_CACHE=true
CACHE_SIZE=1000
CACHE_TTL=3600

# GPU 配置
USE_GPU=true
GPU_DEVICE=0

# ===========================================
# 监控和日志配置
# ===========================================

# 启用性能指标
ENABLE_METRICS=true

# 启用使用统计
ENABLE_USAGE_METRICS=true

# 仅报告首次响应时间
REPORT_ONLY_INITIAL_TTFB=true

# 日志级别
LOG_LEVEL=INFO
# 可选: DEBUG, INFO, WARNING, ERROR

# 日志文件路径
LOG_FILE=./logs/pipecat-chinese.log

# 启用详细日志
VERBOSE_LOGGING=false

# ===========================================
# 网络和传输配置
# ===========================================

# Daily.co 配置
DAILY_ROOM_URL=your_daily_room_url
DAILY_TOKEN=your_daily_token
DAILY_BOT_NAME=中文AI助手

# LiveKit 配置
LIVEKIT_URL=your_livekit_url
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM_NAME=chinese-ai-room

# WebRTC 配置
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=your_turn_server
WEBRTC_TURN_USERNAME=your_turn_username
WEBRTC_TURN_PASSWORD=your_turn_password

# WebSocket 配置
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# ===========================================
# 安全配置
# ===========================================

# API 密钥加密
ENCRYPT_API_KEYS=false
ENCRYPTION_KEY=your_encryption_key

# 访问控制
ENABLE_AUTH=false
AUTH_TOKEN=your_auth_token

# CORS 配置
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_HEADERS=*

# ===========================================
# 开发和调试配置
# ===========================================

# 开发模式
DEBUG_MODE=false

# 保存音频文件用于调试
SAVE_AUDIO_FILES=false
AUDIO_SAVE_PATH=./debug/audio/

# 保存对话记录
SAVE_CONVERSATIONS=false
CONVERSATION_SAVE_PATH=./debug/conversations/

# 模拟延迟 (毫秒)
SIMULATE_LATENCY=0

# 测试模式
TEST_MODE=false
TEST_RESPONSES_FILE=./test/responses.json

# ===========================================
# 扩展功能配置
# ===========================================

# 启用情感分析
ENABLE_EMOTION_ANALYSIS=false
EMOTION_API_KEY=your_emotion_api_key

# 启用语音克隆
ENABLE_VOICE_CLONING=false
VOICE_CLONE_MODEL_PATH=./models/voice-clone/

# 启用实时翻译
ENABLE_TRANSLATION=false
TRANSLATION_API_KEY=your_translation_api_key
SOURCE_LANGUAGE=zh-CN
TARGET_LANGUAGE=en-US

# 启用知识库检索
ENABLE_RAG=false
VECTOR_DB_URL=your_vector_db_url
EMBEDDING_MODEL=text-embedding-ada-002

# ===========================================
# 部署环境配置
# ===========================================

# 环境类型
ENVIRONMENT=development
# 可选: development, staging, production

# 服务名称
SERVICE_NAME=pipecat-chinese

# 版本号
VERSION=1.0.0

# 健康检查端点
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_PATH=/health

# 指标端点
METRICS_PORT=9090
METRICS_PATH=/metrics
