# Apple MLX Whisper 配置文件
# 
# 将此文件重命名为 .env 并根据需要修改配置

# ===========================================
# Apple MLX Whisper 基础配置
# ===========================================

# MLX 模型配置
MLX_WHISPER_MODEL=large-v3-turbo
# 可选值:
# - large-v3-turbo (推荐): 最新的 v3 Turbo 版本，速度快
# - large-v3-turbo-q4: 4位量化版本，更省内存
# - large-v3: 标准 v3 版本
# - medium: 中等大小模型，速度更快但精度略低

# 设备配置 (MLX 自动使用 Apple Silicon GPU)
MLX_DEVICE=auto

# ===========================================
# 语音活动检测 (VAD) 配置
# ===========================================

# VAD 置信度阈值 (0.0-1.0)
VAD_CONFIDENCE=0.7

# 语音开始检测时间 (秒)
VAD_START_SECS=0.2

# 语音结束检测时间 (秒)
VAD_STOP_SECS=2.0

# 最小音量阈值 (0.0-1.0)
VAD_MIN_VOLUME=0.6

# ===========================================
# 音频输入配置
# ===========================================

# 音频采样率
AUDIO_SAMPLE_RATE=16000

# 音频通道数
AUDIO_CHANNELS=1

# 音频缓冲区大小
AUDIO_BUFFER_SIZE=4096

# ===========================================
# 转录配置
# ===========================================

# 默认语言 (留空为自动检测)
TRANSCRIPTION_LANGUAGE=

# 温度参数 (0.0-1.0, 越低越一致)
TRANSCRIPTION_TEMPERATURE=0.0

# 非语音概率阈值 (0.0-1.0)
NO_SPEECH_THRESHOLD=0.4

# ===========================================
# 性能监控配置
# ===========================================

# 启用性能指标
ENABLE_METRICS=true

# 启用使用统计
ENABLE_USAGE_METRICS=true

# 仅报告首次响应时间
REPORT_ONLY_INITIAL_TTFB=true

# ===========================================
# 日志配置
# ===========================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 是否显示转录计数
SHOW_TRANSCRIPTION_COUNT=true

# 是否显示时间戳
SHOW_TIMESTAMP=false

# ===========================================
# 高级配置 (仅在需要时修改)
# ===========================================

# MLX 内存优化
MLX_MEMORY_LIMIT=8192  # MB

# 量化类型 (fp16, int8, int4)
MLX_QUANTIZATION=fp16

# 批处理大小
BATCH_SIZE=1

# 最大序列长度
MAX_SEQUENCE_LENGTH=448
