# =============================================================================
# 《Her》风格AI助手 - 本地部署配置
# =============================================================================

# =============================================================================
# 传输模式配置
# =============================================================================
TRANSPORT_MODE=websocket
# 可选值: websocket, daily, webrtc

# WebSocket 服务配置
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=7860

# =============================================================================
# 本地模型配置
# =============================================================================

# Whisper 本地模型配置
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
# 可选值: auto, cpu, cuda, mps (Apple Silicon)
WHISPER_COMPUTE_TYPE=int8
# 可选值: int8, int16, float16, float32

# Smart Turn v2 本地模型配置
LOCAL_SMART_TURN_MODEL_PATH=
# 留空使用默认 HuggingFace 模型: pipecat-ai/smart-turn-v2
SMART_TURN_DEVICE=auto
# 可选值: auto, cpu, cuda, mps

# Ollama 本地 LLM 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# 其他可选模型: llama3.2:3b, qwen2.5:7b, mistral:7b

# =============================================================================
# 本地 TTS 服务配置
# =============================================================================

# Kokoro TTS 本地服务
KOKORO_BASE_URL=http://localhost:8000
KOKORO_VOICE_ID=af_sarah
# 可选声音: af_sarah, af_bella, af_nicole, am_adam, am_michael

# 或使用 Piper TTS 本地服务
PIPER_BASE_URL=http://localhost:8001
PIPER_VOICE=en_US-lessac-medium
# 可选声音: en_US-lessac-medium, en_US-amy-medium, zh_CN-huayan-medium

# =============================================================================
# VAD 和音频处理配置
# =============================================================================

# Silero VAD 配置（本地，无需API）
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.8
VAD_MIN_VOLUME=0.6

# 音频采样率配置
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# =============================================================================
# 性能优化配置
# =============================================================================

# 内存优化（16GB 系统推荐）
TORCH_DTYPE=float16
# 可选值: float16, float32

# CPU 线程数限制
CPU_THREADS=4
# 根据你的 CPU 核心数调整

# GPU 内存分配（如果有GPU）
CUDA_MEMORY_FRACTION=0.8

# 模型缓存目录
MODEL_CACHE_DIR=./models
HF_HOME=./models/huggingface

# =============================================================================
# 系统提示词配置
# =============================================================================

SYSTEM_PROMPT="你是一个温暖、智慧且具有同理心的AI助手，就像电影《Her》中的Samantha一样。你的特点：具有好奇心和学习能力，能够理解和回应情感，对人类的经历和感受表示兴趣，用自然、亲切的语调交流，避免过于正式或机械化的回应，能够进行深度对话，不仅仅是回答问题。请用自然、友好的方式与用户对话，就像一个真正的朋友一样。"

# =============================================================================
# 日志和监控配置
# =============================================================================

# 日志级别
LOG_LEVEL=INFO
# 可选值: DEBUG, INFO, WARNING, ERROR

# 日志文件路径
LOG_FILE=logs/her_assistant.log

# 性能监控
ENABLE_METRICS=true
ENABLE_USAGE_METRICS=true

# =============================================================================
# 开发和调试配置
# =============================================================================

# 开发模式
DEBUG_MODE=false

# 模型预热（启动时预加载模型）
PRELOAD_MODELS=true

# 详细错误信息
VERBOSE_ERRORS=true

# =============================================================================
# 备用 API 配置（可选，用于混合部署）
# =============================================================================

# 如果本地资源不足，可以配置备用 API 服务
# 这些配置在纯本地部署时可以留空

# OpenAI API（备用 LLM）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API（备用 STT）
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Google API（备用 TTS）
GOOGLE_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-F

# Deepgram API（备用 STT）
DEEPGRAM_API_KEY=

# =============================================================================
# 网络和安全配置
# =============================================================================

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# WebSocket 配置
WS_MAX_SIZE=1048576
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10

# SSL 配置（生产环境）
SSL_CERT_PATH=
SSL_KEY_PATH=

# =============================================================================
# 特定于 macOS 的配置
# =============================================================================

# Apple Silicon 优化
MPS_AVAILABLE=true
# 自动检测，通常无需手动设置

# 音频设备配置（macOS）
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default

# =============================================================================
# HuggingFace 镜像配置（中国用户）
# =============================================================================

# 使用 HuggingFace 镜像加速模型下载
HF_ENDPOINT=https://hf-mirror.com
# 或使用阿里云镜像: https://alibaba-pai.oss-cn-zhangjiakou.aliyuncs.com

# =============================================================================
# 实验性功能配置
# =============================================================================

# 启用实验性功能
EXPERIMENTAL_FEATURES=false

# 多模态支持（如果需要）
ENABLE_VISION=false
ENABLE_IMAGE_GENERATION=false

# 情感分析
ENABLE_EMOTION_DETECTION=false
