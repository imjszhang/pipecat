# =============================================================================
# 《Her》风格AI助手 - 本地部署配置
# =============================================================================
#
# 使用说明:
# 1. 复制此文件为 .env: cp env.example .env
# 2. 根据你的系统配置修改相应参数
# 3. 确保已安装并启动 Ollama 服务: ollama serve
# 4. 下载所需模型: ollama pull gemma2:2b
# 5. 运行助手: python bot.py
#
# 系统要求:
# - 内存: 16GB+ RAM 推荐
# - 存储: 50GB+ 可用空间（用于模型）
# - Python: 3.10+
# - 网络: 首次下载模型需要网络连接
#
# =============================================================================

# =============================================================================
# 传输模式配置
# =============================================================================
TRANSPORT_MODE=websocket
# 可选值: websocket, daily, webrtc

# WebSocket 服务配置
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=7860

# =============================================================================
# 本地模型配置
# =============================================================================

# Whisper 本地模型配置
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
# 可选值: auto, cpu, cuda, mps (Apple Silicon)
WHISPER_COMPUTE_TYPE=int8
# 可选值: int8, int16, float16, float32
# 注意: 首次运行会自动下载模型，需要网络连接

# Smart Turn v2 本地模型配置
LOCAL_SMART_TURN_MODEL_PATH=
# 留空使用默认 HuggingFace 模型: pipecat-ai/smart-turn-v2
SMART_TURN_DEVICE=auto
# 可选值: auto, cpu, cuda, mps

# Ollama 本地 LLM 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
# 其他可选模型: llama3.2:3b, qwen2.5:7b, mistral:7b, gemma2:9b
# 注意: gemma3:4b 目前在 Ollama 中可能不可用，推荐使用 gemma2:2b

# =============================================================================
# 本地 TTS 服务配置
# =============================================================================

# Piper TTS 本地服务（推荐）
PIPER_BASE_URL=http://localhost:8001
PIPER_VOICE=en_US-lessac-medium
# 可选声音: en_US-lessac-medium, en_US-amy-medium, zh_CN-huayan-medium
# 注意: 需要先安装并启动 Piper TTS 服务: python -m piper.http_server --host 0.0.0.0 --port 8001

# =============================================================================
# VAD 和音频处理配置
# =============================================================================

# Silero VAD 配置（本地，无需API）
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.8
VAD_MIN_VOLUME=0.6

# 音频采样率配置
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# =============================================================================
# 性能优化配置
# =============================================================================

# 内存优化（16GB 系统推荐）
TORCH_DTYPE=float16
# 可选值: float16, float32

# CPU 线程数限制（建议设置为 CPU 核心数的一半）
CPU_THREADS=4
# 根据你的 CPU 核心数调整，macOS 可以用: sysctl -n hw.ncpu

# GPU 内存分配（如果有GPU）
CUDA_MEMORY_FRACTION=0.8
# Apple Silicon 用户无需设置此项

# 模型缓存目录
MODEL_CACHE_DIR=./models
HF_HOME=./models/huggingface

# =============================================================================
# 系统提示词配置
# =============================================================================

SYSTEM_PROMPT="你是一个温暖、智慧且具有同理心的AI助手，就像电影《Her》中的Samantha一样。你的特点：具有好奇心和学习能力，能够理解和回应情感，对人类的经历和感受表示兴趣，用自然、亲切的语调交流，避免过于正式或机械化的回应，能够进行深度对话，不仅仅是回答问题。请用自然、友好的方式与用户对话，就像一个真正的朋友一样。"

# =============================================================================
# 日志和监控配置
# =============================================================================

# 日志级别
LOG_LEVEL=INFO
# 可选值: DEBUG, INFO, WARNING, ERROR

# 日志文件路径
LOG_FILE=logs/her_assistant.log

# 性能监控
ENABLE_METRICS=true
ENABLE_USAGE_METRICS=true

# =============================================================================
# 开发和调试配置
# =============================================================================

# 开发模式
DEBUG_MODE=false

# 模型预热（启动时预加载模型，首次启动较慢但后续更快）
PRELOAD_MODELS=true

# 详细错误信息（开发调试时建议开启）
VERBOSE_ERRORS=true

# 语言设置（支持中英文）
WHISPER_LANGUAGE=auto
# 可选值: auto, en, zh, ja, ko 等

# =============================================================================
# 备用 API 配置（可选，用于混合部署）
# =============================================================================

# 如果本地资源不足，可以配置备用 API 服务
# 这些配置在纯本地部署时可以留空，仅在需要时填写

# OpenAI API（备用 LLM，当 Ollama 不可用时使用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API（备用 STT，当 Whisper 本地模型不可用时使用）
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Google API（备用 TTS，当 Piper TTS 不可用时使用）
GOOGLE_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-F

# Deepgram API（备用 STT）
DEEPGRAM_API_KEY=

# =============================================================================
# 网络和安全配置
# =============================================================================

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# WebSocket 配置
WS_MAX_SIZE=1048576
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10

# SSL 配置（生产环境）
SSL_CERT_PATH=
SSL_KEY_PATH=

# =============================================================================
# 特定于 macOS 的配置
# =============================================================================

# Apple Silicon 优化（自动检测，无需手动设置）
MPS_AVAILABLE=true
# 系统会自动检测 Apple Silicon 并启用 MPS 加速

# 音频设备配置（macOS）
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default

# =============================================================================
# HuggingFace 镜像配置（中国用户）
# =============================================================================

# 使用 HuggingFace 镜像加速模型下载（中国用户推荐）
HF_ENDPOINT=https://hf-mirror.com
# 或使用阿里云镜像: https://alibaba-pai.oss-cn-zhangjiakou.aliyuncs.com
# 海外用户可以注释掉此行使用官方源

# =============================================================================
# 实验性功能配置
# =============================================================================

# 启用实验性功能
EXPERIMENTAL_FEATURES=false

# 多模态支持（如果需要）
ENABLE_VISION=false
ENABLE_IMAGE_GENERATION=false

# 情感分析
ENABLE_EMOTION_DETECTION=false

# =============================================================================
# 配置验证和故障排除
# =============================================================================

# 启动前检查（建议保持开启）
CHECK_PREREQUISITES=true

# 服务健康检查超时（秒）
SERVICE_CHECK_TIMEOUT=10

# 自动重试次数
MAX_RETRY_ATTEMPTS=3

# =============================================================================
# 常见问题解决方案
# =============================================================================
#
# 问题1: Ollama 连接失败
# 解决: 确保 Ollama 服务正在运行
#   - 检查: curl http://localhost:11434/api/tags
#   - 启动: ollama serve
#
# 问题2: 模型未找到
# 解决: 下载所需模型
#   - 检查: ollama list
#   - 下载: ollama pull gemma2:2b
#
# 问题3: 内存不足
# 解决: 使用更小的模型或调整配置
#   - 设置 TORCH_DTYPE=float16
#   - 设置 WHISPER_COMPUTE_TYPE=int8
#   - 使用 gemma2:2b 而不是更大的模型
#
# 问题4: TTS 服务不可用
# 解决: 启动 Piper TTS 服务
#   - 安装: pip install piper-tts
#   - 启动: python -m piper.http_server --host 0.0.0.0 --port 8001
#
# 问题5: Apple Silicon 性能问题
# 解决: 确保使用 MPS 加速
#   - 设置 WHISPER_DEVICE=mps
#   - 设置 SMART_TURN_DEVICE=mps
#
# =============================================================================
